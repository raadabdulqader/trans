# ==============================================================================
# بيئة العمل وإعدادات الاتصال بقاعدة البيانات (VPS + Coolify + PostgreSQL)
# ==============================================================================

# رابط الاتصال بقاعدة بيانات PostgreSQL:
# في Coolify، بعد إنشاء مورد PostgreSQL، ستحصل على Internal Database URL:
DATABASE_URL="postgres://postgres:password@postgres:5432/nakah?schema=public"

# منفذ التشغيل (افتراضي 3000):
PORT=3000

# بيئة التشغيل:
NODE_ENV=production

# رابط النطاق أو الدومين الخاص بالتطبيق (Domain / FQDN):
NEXT_PUBLIC_APP_URL="https://trans.mdd-iq.com"
